# Feynman Challenge — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
# Client-safe (exposed to browser):
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side ONLY — never expose to the client:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Rahasia untuk rute terjadwal /api/cron/* (minimal 16 karakter, mis. hasil
# `openssl rand -hex 32`). Kosong = rute terjadwal menolak semua permintaan.
CRON_SECRET=

# --- CAPTCHA (Cloudflare Turnstile, opsional) ---
# Kosong = tanpa CAPTCHA. Kalau diisi, aktifkan juga CAPTCHA di Supabase
# (Authentication > Attack Protection) dengan SECRET key Turnstile yang sepasang.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Gemini ---
# Server-side ONLY — never expose to the client:
GEMINI_API_KEY=your_gemini_api_key

# Isi "1" HANYA setelah kunci Gemini memakai paket berbayar (billing aktif).
# Halaman /privasi lalu menyatakan Google tidak memakai rekaman untuk
# meningkatkan produknya. Kosong = halaman menjelaskan aturan tier gratis.
GEMINI_PAID_TIER=

# --- Situs ---
# Biarkan kosong saat uji coba. Isi "1" HANYA saat peluncuran sungguhan:
# tanpa ini, robots.txt melarang semua crawler dan setiap halaman mengirim noindex.
NEXT_PUBLIC_ALLOW_INDEXING=
# Origin kanonik, mis. https://feynman.vercel.app (dipakai Open Graph & sitemap)
NEXT_PUBLIC_SITE_URL=
# Email untuk permintaan privasi, tampil di /privasi dan /syarat.
CONTACT_EMAIL=
